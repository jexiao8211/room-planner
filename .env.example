# Copy to .env and fill in.
#
# Which backend serves photo analysis and product search:
#   auto         (default) MOCK_AI=1 → demo data; else ANTHROPIC_API_KEY set → API; else your Claude subscription
#   api          Claude API with ANTHROPIC_API_KEY (required)
#   subscription your Claude Pro/Max plan via the Claude Agent SDK (Claude Code signed in on this machine; no key)
#   mock         demo data, no Claude calls
AI_PROVIDER=auto
# Leave empty to use your Claude subscription (or demo data with MOCK_AI=1). With AI_PROVIDER=auto, a key here wins.
ANTHROPIC_API_KEY=
# Demo data under AI_PROVIDER=auto, even when a key is present (1 = on)
MOCK_AI=0
API_PORT=8787
